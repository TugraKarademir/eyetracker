# Bu dosyayı ".env" adıyla kopyala ve anahtarlarını yaz. .env asla paylaşılmamalı.

# Zorunlu: yazıya dökme + çeviri (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# İsteğe bağlı ama önerilir: kendi sesinle İngilizce konuşma (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=

# ses_klonla.py çalışınca otomatik doldurulur (ya da ElevenLabs'te oluşturduğun sesin Voice ID'si)
ELEVENLABS_VOICE_ID=
